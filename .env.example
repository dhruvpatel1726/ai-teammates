# Clerk — get these from https://dashboard.clerk.com (API keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Auth routes
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Neon Postgres — pooled connection for the app (hostname contains "-pooler")
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require

# Neon Postgres — direct connection for migrations (no "-pooler")
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require

# xAI — API key for Grok chat responses (https://console.x.ai)
XAI_API_KEY=xai-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Trigger.dev — server key for background tasks (https://trigger.dev/dashboard)
TRIGGER_SECRET_KEY=tr_dev_sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Per-period hard caps in USD (defaults to 5 each when omitted)
USAGE_AI_LIMIT_USD=5
USAGE_SANDBOX_LIMIT_USD=5
